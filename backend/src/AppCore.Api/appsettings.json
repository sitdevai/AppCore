{
  "AllowedHosts": "",
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "ConnectionString": ""
  },
  "DataProtection": {
    "ApplicationName": "AppCore",
    "KeyStoragePath": "",
    "CertificateThumbprint": ""
  },
  "SecurityKeys": {
    "CurrentVersion": 1,
    "Keys": {}
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "LoggingRedaction": {
    "SensitiveKeys": [
      "authorization",
      "connectionstring",
      "cookie",
      "password",
      "secret",
      "token"
    ]
  },
  "OpenApi": {
    "EnableInProduction": false
  },
  "RateLimiting": {
    "SensitivePermitLimit": 10,
    "SensitiveQueueLimit": 0,
    "SensitiveWindowSeconds": 60
  }
}
